<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dorado.Plugin.Sample</RootNamespace>
    <AssemblyName>Dorado.Plugin.Sample</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the Dorado plugin SDK (NuGet package or project reference). -->
    <ProjectReference Include="..\..\src\Dorado.Plugins.Sdk\Dorado.Plugins.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PackZnp" AfterTargets="Publish">
    <PropertyGroup>
      <ZnpDestination>$(PublishDir)../$(AssemblyName).znp</ZnpDestination>
    </PropertyGroup>
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(ZnpDestination)" Overwrite="true" />
    <Message Importance="high" Text="Packed plugin: $(ZnpDestination)" />
  </Target>

</Project>
