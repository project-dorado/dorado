<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dorado.UI.ViewModels;assembly=Dorado.UI"
             xmlns:design="clr-namespace:Dorado.UI.Design;assembly=Dorado.UI"
             xmlns:models="clr-namespace:Dorado.Domain.Models;assembly=Dorado.Domain"
             xmlns:interfaces="clr-namespace:Dorado.Application.Interfaces;assembly=Dorado.Application"
             xmlns:conv="clr-namespace:Dorado.UI.Converters;assembly=Dorado.UI"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Dorado.UI.Views.ZuneCardView"
             x:DataType="vm:ZuneCardViewModel">

  <ScrollViewer Margin="40,16,40,24">
    <StackPanel Spacing="28" MaxWidth="820" HorizontalAlignment="Left">
      
      <!-- Top Card Header: Avatar & Member Info -->
      <Border Background="{DynamicResource ZuneSurfaceElevatedBrush}" 
              BorderBrush="{DynamicResource ZuneBorderBrush}" 
              BorderThickness="1" 
              CornerRadius="0" 
              Padding="24">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- User Avatar Box -->
          <Border Grid.Column="0" 
                  Width="68" Height="68" 
                  Background="{DynamicResource ZuneCardBrush}" 
                  BorderBrush="{DynamicResource ZuneAccentBrush}" 
                  BorderThickness="2" 
                  CornerRadius="0" 
                  Margin="0,0,20,0">
            <Grid>
              <Path Data="{x:Static design:ZuneGlyphs.ProfileTile}" Stretch="Uniform" Fill="{DynamicResource ZuneTextDimmedBrush}" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <!-- User avatar overrides the placeholder glyph when one is set. -->
              <Image Source="{Binding AvatarUri, Converter={x:Static conv:ArtworkSourceConverter.Instance}}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
            </Grid>
          </Border>

          <!-- User Zune Tag & Bio (view mode) -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding !IsEditingProfile}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding ZuneTag}" Classes="mega-title" FontWeight="Light" VerticalAlignment="Center" />
              <Button Command="{Binding BeginEditProfileCommand}" Classes="zune-action" VerticalAlignment="Center" Padding="8,4">
                <TextBlock Text="EDIT PROFILE" Classes="caption" FontWeight="SemiBold" />
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding MemberSinceText}" Classes="caption" FontWeight="Bold" Foreground="{DynamicResource ZuneAccentBrush}" LetterSpacing="1" />
            <TextBlock Text="{Binding StatusMessage}" Classes="body" Foreground="{DynamicResource ZuneTextSecondaryBrush}" Margin="0,2,0,0" />
          </StackPanel>

          <!-- User Zune Tag & Bio (edit mode) -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding IsEditingProfile}" Margin="0,0,20,0">
            <TextBox Text="{Binding EditZuneTag}" Watermark="Zune tag" MaxLength="32" />
            <TextBox Text="{Binding EditStatusMessage}" Watermark="Status message" MaxLength="120" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding PickAvatarCommand}" Classes="zune-action" Padding="10,5">
                <TextBlock Text="CHOOSE AVATAR" Classes="caption" FontWeight="SemiBold" />
              </Button>
              <Button Command="{Binding SaveProfileCommand}" Classes="zune-accent-btn" Padding="10,5">
                <TextBlock Text="SAVE" Classes="caption" FontWeight="Bold" />
              </Button>
              <Button Command="{Binding CancelEditProfileCommand}" Classes="zune-action" Padding="10,5">
                <TextBlock Text="CANCEL" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
              </Button>
            </StackPanel>
          </StackPanel>

          <!-- Stat Counters -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
            <Border Background="{DynamicResource ZuneCardBrush}" Padding="16,10" CornerRadius="0">
              <StackPanel HorizontalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding TotalTracksPlayed}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ZuneTextActiveBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="SCROBBLES" Classes="caption" Foreground="{DynamicResource ZuneTextDimmedBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource ZuneCardBrush}" Padding="16,10" CornerRadius="0">
              <StackPanel HorizontalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding TotalHoursText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ZuneAccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="LISTENING" Classes="caption" Foreground="{DynamicResource ZuneTextDimmedBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Two-Column Analytics Layout: Top Artists & Badges -->
      <Grid ColumnDefinitions="*,32,*">
        
        <!-- Left Wing: Top Played Artists -->
        <Border Grid.Column="0" 
                Background="{DynamicResource ZuneSurfaceElevatedBrush}" 
                BorderBrush="{DynamicResource ZuneBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="0" 
                Padding="24">
          <StackPanel Spacing="16">
            <TextBlock Text="HEAVY ROTATION (TOP ARTISTS)" Classes="caption" FontWeight="Bold" Foreground="{DynamicResource ZuneAccentBrush}" LetterSpacing="1" />
            
            <ItemsControl ItemsSource="{Binding TopArtists}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:TopArtistStat">
                  <Border BorderBrush="{DynamicResource ZuneBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="0,10">
                    <Grid RowDefinitions="Auto,Auto">
                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding ArtistName}" Classes="body" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding PlayCount, StringFormat='{}{0} plays'}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
                      </Grid>
                      <!-- Progress bar of share -->
                      <ProgressBar Grid.Row="1" 
                                   Margin="0,6,0,0" 
                                   Height="3" 
                                   CornerRadius="0" 
                                   Value="{Binding Percentage}" 
                                   Maximum="100.0" 
                                   Foreground="{DynamicResource ZuneAccentBrush}" 
                                   Background="{DynamicResource ZuneCardBrush}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Right Wing: Zune Achievement Badges -->
        <Border Grid.Column="2" 
                Background="{DynamicResource ZuneSurfaceElevatedBrush}" 
                BorderBrush="{DynamicResource ZuneBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="0" 
                Padding="24">
          <StackPanel Spacing="16">
            <TextBlock Text="ZUNE BADGES &amp; MILESTONES" Classes="caption" FontWeight="Bold" Foreground="{DynamicResource ZuneAccentBrush}" LetterSpacing="1" />
            
            <ItemsControl ItemsSource="{Binding Badges}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ZuneBadge">
                  <Border BorderBrush="{DynamicResource ZuneBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="0,10">
                    <Grid ColumnDefinitions="36,*">
                      <!-- Badge Seal Icon -->
                      <Path Grid.Column="0"
                            Data="{x:Static design:ZuneGlyphs.Seal}"
                            Stretch="Uniform"
                            Fill="{DynamicResource ZuneAccentBrush}"
                            Width="26" Height="25"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />
                      
                      <StackPanel Grid.Column="1" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Title}" Classes="body" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Category}" Classes="caption" Foreground="{DynamicResource ZuneAccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding TierText}" Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource ZuneAccentBrush}" />
                          <TextBlock Text="{Binding ProgressText}" Classes="caption" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </Grid>

      <!-- Live cloud Zune Card (shown when the cloud is enabled and a handle is set) -->
      <Border IsVisible="{Binding HasLiveCard}"
              Background="{DynamicResource ZuneSurfaceElevatedBrush}"
              BorderBrush="{DynamicResource ZuneAccentBrush}"
              BorderThickness="1"
              CornerRadius="0"
              Padding="24">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="LIVE ZUNE CARD" Classes="caption" FontWeight="Bold" Foreground="{DynamicResource ZuneAccentBrush}" LetterSpacing="1" />
            <TextBlock Grid.Column="1" Text="{Binding LiveHandle, StringFormat='@{0}'}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="24">
            <TextBlock Text="{Binding LiveFollowersText}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
            <TextBlock Text="{Binding LiveFollowingText}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
            <TextBlock Text="{Binding LiveActivitiesText}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding LiveRecent}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="interfaces:ZuneCardActivity">
                <Border BorderBrush="{DynamicResource ZuneBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="0,8">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="{Binding Kind}" Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource ZuneAccentBrush}" Width="90" />
                    <TextBlock Grid.Column="1" Text="{Binding PayloadJson}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
