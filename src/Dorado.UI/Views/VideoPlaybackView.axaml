<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dorado.UI.ViewModels;assembly=Dorado.UI"
             xmlns:design="clr-namespace:Dorado.UI.Design;assembly=Dorado.UI"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             xmlns:conv="clr-namespace:Dorado.UI.Converters;assembly=Dorado.UI"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="540"
             x:Class="Dorado.UI.Views.VideoPlaybackView"
             x:DataType="vm:VideoPlaybackViewModel"
             Width="840">
  <Border Background="#FF0A0A0A"
          BorderBrush="{DynamicResource ZuneBorderBrush}"
          BorderThickness="1"
          CornerRadius="0"
          Padding="16">
    <StackPanel Spacing="12">

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding VideoTitle}" Classes="hero" FontSize="22" Foreground="{DynamicResource ZuneTextActiveBrush}" />
        <Button Grid.Column="1" Command="{Binding CloseCommand}" Background="Transparent" BorderThickness="0" Padding="6">
          <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
        </Button>
      </Grid>

      <!-- Video Surface -->
      <Border Background="Black" Height="430" CornerRadius="0">
        <Panel>
          <vlc:VideoView MediaPlayer="{Binding MediaPlayerHandle, Converter={x:Static conv:ObjectToMediaPlayerConverter.Instance}}" IsVisible="{Binding IsVideoAvailable}" />
          <TextBlock Text="{Binding UnavailableText}"
                     Classes="body"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource ZuneTextDimmedBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Padding="40"
                     IsVisible="{Binding !IsVideoAvailable}" />
          <Path Data="{x:Static design:ZuneGlyphs.PlayCircle}" Stretch="Uniform" Fill="{DynamicResource ZuneTextActiveBrush}" Width="72" Height="72"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding !IsPlaying}" Opacity="0.7" />
        </Panel>
      </Border>

      <!-- Transport -->
      <StackPanel Spacing="6">
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" Height="3" CornerRadius="0" Foreground="{DynamicResource ZuneAccentBrush}" Background="{DynamicResource ZuneSurfaceElevatedBrush}" />
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button Command="{Binding PlayPauseCommand}" Classes="zune-action">
              <TextBlock Text="{Binding PlayPauseIcon}" FontSize="14" />
            </Button>
            <Button Command="{Binding StopCommand}" Classes="zune-action">
              <TextBlock Text="⏹" FontSize="13" />
            </Button>
            <TextBlock Text="{Binding TimeText}" Classes="caption" VerticalAlignment="Center" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>
          <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SeekFraction, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0" />
          <TextBlock Grid.Column="2" Text="NOW PLAYING — VIDEO" Classes="caption" FontSize="9" LetterSpacing="1" VerticalAlignment="Center" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
