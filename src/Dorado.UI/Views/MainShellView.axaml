<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dorado.UI.ViewModels;assembly=Dorado.UI"
             xmlns:design="clr-namespace:Dorado.UI.Design;assembly=Dorado.UI"
             xmlns:views="clr-namespace:Dorado.UI.Views;assembly=Dorado.UI"
             xmlns:animations="clr-namespace:Dorado.UI.Animations;assembly=Dorado.UI"
             xmlns:conv="clr-namespace:Dorado.UI.Converters;assembly=Dorado.UI"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
             x:Class="Dorado.UI.Views.MainShellView"
             x:DataType="vm:MainShellViewModel"
             Background="{DynamicResource ZuneBackgroundBrush}">

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:QuickplayViewModel">
      <views:QuickplayView />
    </DataTemplate>
    <DataTemplate DataType="vm:CollectionViewModel">
      <views:CollectionView />
    </DataTemplate>
    <DataTemplate DataType="vm:DeviceViewModel">
      <views:DeviceView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:NowPlayingViewModel">
      <views:NowPlayingView />
    </DataTemplate>
    <DataTemplate DataType="vm:ZuneCardViewModel">
      <views:ZuneCardView />
    </DataTemplate>
    <DataTemplate DataType="vm:PodcastsViewModel">
      <views:PodcastsView />
    </DataTemplate>
    <DataTemplate DataType="vm:MixviewViewModel">
      <views:MixviewView />
    </DataTemplate>
    <DataTemplate DataType="vm:CDViewModel">
      <views:CDView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
    <!-- MODE 1: COMPACT MINI PLAYER (Floating Widget) -->
    <views:CompactMiniPlayerView IsVisible="{Binding IsCompactMode}" />

    <!-- MODE 2: FULL METRO APPLICATION SHELL -->
    <Grid IsVisible="{Binding !IsCompactMode}" RowDefinitions="Auto,*,Auto">
      
      <!-- Authentic Zune 4.8 Background Vector Art Header Canvas.
           RowSpan=3 keeps it behind the shell without inflating the Auto header row. -->
      <Image Grid.Row="0" Grid.RowSpan="3"
             Source="{Binding SelectedBackgroundArt}"
             IsVisible="{Binding HasBackgroundArt}"
             Stretch="UniformToFill"
             Opacity="0.20"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             Height="200"
             IsHitTestVisible="False" />

      <!-- 1. Custom Borderless Window Chrome & Panoramic Pivot Navigation Header -->
      <Grid Grid.Row="0" 
            Background="Transparent" 
            PointerPressed="OnTitleBarPointerPressed"
            RowDefinitions="36,60"
            Margin="24,8,8,0">
        
        <!-- Topmost System Row: Cropped Header Title (back affordance) + Brand Wordmark + Minimal Window Controls -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
          <!-- Zune 4.8 cropped-title back affordance (bleeds off the left edge; click → GoBack) -->
          <Panel Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-32,0,0,0" IsHitTestVisible="True"
                 PointerPressed="OnCroppedHeaderPointerPressed"
                 Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="&#x2190;"
                         IsVisible="{Binding IsCroppedHeaderBack}"
                         FontFamily="{StaticResource ZunePivotFontFamily}"
                         FontSize="18"
                         Foreground="{DynamicResource ZuneAccentBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding CroppedHeaderTitle}"
                         Classes="hero"
                         FontSize="34"
                         FontWeight="Light"
                         Foreground="{DynamicResource ZuneTextActiveBrush}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="260" />
            </StackPanel>
          </Panel>

          <!-- Zune Brand Wordmark (hidden when the cropped-header title is in detail mode) -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                      IsVisible="{Binding !IsCroppedHeaderDetail}">
            <Path Data="{x:Static design:ZuneGlyphs.BrandMark}" Stretch="Uniform" Fill="{DynamicResource ZuneAccentBrush}" Width="18" Height="19" VerticalAlignment="Center" />
            <TextBlock Text="ZUNE"
                       FontFamily="{StaticResource ZunePivotFontFamily}"
                       FontSize="12"
                       FontWeight="Bold" 
                       LetterSpacing="3" 
                       Foreground="{DynamicResource ZuneTextDimmedBrush}" 
                       VerticalAlignment="Center" />
          </StackPanel>

          <!-- Window Action Controls (User Tile, Compact Mode, Minimize, Maximize, Close) -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
            <!-- User Tile Avatar Button (Quick Access to Zune Card) -->
            <Button Command="{Binding ToggleZuneCardCommand}" 
                    Background="Transparent" 
                    Padding="4,2" 
                    Margin="0,0,8,0"
                    ToolTip.Tip="Zune Card Profile &amp; Badges">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Width="18" Height="18" BorderBrush="{DynamicResource ZuneAccentBrush}" BorderThickness="1" CornerRadius="0">
                  <Path Data="{x:Static design:ZuneGlyphs.ProfileTile}" Stretch="Uniform" Fill="{DynamicResource ZuneTextDimmedBrush}" Width="16" Height="16" />
                </Border>
                <TextBlock Text="ZUNECARD" 
                           FontFamily="{StaticResource ZunePivotFontFamily}" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           LetterSpacing="1" 
                           Foreground="{DynamicResource ZuneTextSecondaryBrush}" 
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Compact Mini Player Mode Button -->
            <Button Classes="window-control" Command="{Binding ToggleCompactModeCommand}" ToolTip.Tip="Compact Mini Player Mode">
              <Path Data="{x:Static design:ZuneGlyphs.CompactMode}" Stretch="Uniform" Stroke="{DynamicResource ZuneTextSecondaryBrush}" StrokeThickness="1.6" Width="14" Height="15" />
            </Button>
            <Button Classes="window-control" Click="OnMinimizeClicked" ToolTip.Tip="Minimize">
              <Path Data="{x:Static design:ZuneGlyphs.Minimize}" Stretch="Uniform" Stroke="{DynamicResource ZuneTextSecondaryBrush}" StrokeThickness="1.6" Width="14" Height="15" />
            </Button>
            <Button Classes="window-control" Click="OnMaximizeClicked" ToolTip.Tip="Maximize / Restore">
              <Path Data="{x:Static design:ZuneGlyphs.Maximize}" Stretch="Uniform" Stroke="{DynamicResource ZuneTextSecondaryBrush}" StrokeThickness="1.6" Width="14" Height="15" />
            </Button>
            <Button Classes="window-control window-close" Click="OnCloseClicked" ToolTip.Tip="Close">
              <Path Data="{x:Static design:ZuneGlyphs.Close}" Stretch="Uniform" Stroke="{DynamicResource ZuneTextSecondaryBrush}" StrokeThickness="1.6" Width="14" Height="15" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- Second Row: Primary Panoramic Pivots & Search / Mode Toggles -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="12,0,16,0">
          <!-- Left: Iconic Zune Metro Panoramic Pivots (pannable at narrow widths — content bleeds off the right edge) -->
          <Grid Grid.Column="0">
          <ScrollViewer x:Name="PivotStrip"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        PointerWheelChanged="OnPivotStripPointerWheelChanged"
                        PointerPressed="OnPivotStripPointerPressed"
                        PointerMoved="OnPivotStripPointerMoved"
                        PointerReleased="OnPivotStripPointerReleased"
                        PointerCaptureLost="OnPivotStripPointerCaptureLost">
            <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
              <Button Command="{Binding SelectPivotCommand}" CommandParameter="{x:Static vm:NavigationPivot.Quickplay}">
                <TextBlock Text="QUICKPLAY" Classes="pivot-header" Classes.active="{Binding IsQuickplayActive}" />
              </Button>
              <Button Command="{Binding SelectPivotCommand}" CommandParameter="{x:Static vm:NavigationPivot.Collection}">
                <TextBlock Text="COLLECTION" Classes="pivot-header" Classes.active="{Binding IsCollectionActive}" />
              </Button>
              <Button Command="{Binding SelectPivotCommand}" CommandParameter="{x:Static vm:NavigationPivot.Device}">
                <TextBlock Text="DEVICE" Classes="pivot-header" Classes.active="{Binding IsDeviceActive}" />
              </Button>
              <Button Command="{Binding SelectPivotCommand}" CommandParameter="{x:Static vm:NavigationPivot.Disc}">
                <TextBlock Text="DISC" Classes="pivot-header" Classes.active="{Binding IsDiscActive}" />
              </Button>
              <Button Command="{Binding SelectPivotCommand}" CommandParameter="{x:Static vm:NavigationPivot.Social}">
                <TextBlock Text="SOCIAL" Classes="pivot-header" Classes.active="{Binding IsSocialActive}" />
              </Button>
            </StackPanel>
          </ScrollViewer>
            <!-- Procedural chevron scroll affordances (Phase 22) -->
            <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="4"
                    Click="OnPivotScrollLeft" ToolTip.Tip="Scroll pivots left">
              <Path Data="M 8,0 L 0,7 L 8,14" Stroke="{DynamicResource ZuneTextSecondaryBrush}" StrokeThickness="2" />
            </Button>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="4"
                    Click="OnPivotScrollRight" ToolTip.Tip="Scroll pivots right">
              <Path Data="M 0,0 L 8,7 L 0,14" Stroke="{DynamicResource ZuneTextSecondaryBrush}" StrokeThickness="2" />
            </Button>
          </Grid>

          <!-- Right: Back, Search Box, Now Playing & Settings -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
            <!-- Navigation Back (Zune window back arrow) -->
            <Button Command="{Binding GoBackCommand}"
                    IsEnabled="{Binding CanGoBack}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="2"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Back">
              <Path Data="{x:Static design:ZuneGlyphs.ArrowBack}" Stretch="Uniform" Stroke="{DynamicResource ZuneTextActiveBrush}" StrokeThickness="1.6" Width="24" Height="24" IsVisible="{Binding CanGoBack}" />
            </Button>

            <!-- Header Search Box with Autocomplete (hidden on quickplay/now playing/settings, ShowSearch parity) -->
            <Panel VerticalAlignment="Center" Width="150" IsVisible="{Binding IsHeaderSearchVisible}">
              <Border Background="{DynamicResource ZuneInputBackgroundBrush}"
                      BorderBrush="{DynamicResource ZuneSubtleBorderBrush}"
                      BorderThickness="1"
                      Height="26"
                      CornerRadius="0">
                <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="HeaderSearchBox"
                         Grid.Column="0"
                         Text="{Binding HeaderSearchQuery, Mode=TwoWay}"
                         Watermark="search collection"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource ZuneTextActiveBrush}"
                         FontSize="11"
                         Height="24"
                         MinHeight="24"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Padding="6,1" />
                <Button Grid.Column="1" 
                        Command="{Binding ClearSearchCommand}" 
                        IsVisible="{Binding HasHeaderSearchQuery}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="4,2,6,2" 
                        VerticalAlignment="Center">
                  <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
                </Button>
              </Grid>
            </Border>

              <!-- Autocomplete suggestions dropdown (AUTOCOMPLETEBOX parity) -->
              <Border IsVisible="{Binding HasSearchSuggestions}"
                      Background="{DynamicResource ZuneSurfaceElevatedBrush}"
                      BorderBrush="{DynamicResource ZuneBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="0"
                      Margin="0,28,0,0"
                      ZIndex="100"
                      MaxHeight="200">
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding SearchSuggestions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).AcceptSuggestionCommand}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8,5">
                          <TextBlock Text="{Binding}" Classes="caption" TextTrimming="CharacterEllipsis" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Panel>

            <!-- Animated Now Playing Dancing Equalizer Button -->
            <Button Command="{Binding ToggleNowPlayingCommand}" VerticalAlignment="Center"
                    PointerEntered="OnNowPlayingButtonPointerEntered"
                    PointerExited="OnNowPlayingButtonPointerExited"
                    PointerPressed="OnNowPlayingButtonPointerPressed">
              <Border BorderBrush="{DynamicResource ZuneAccentBrush}"
                      BorderThickness="1"
                      Padding="12,4"
                      Background="{DynamicResource ZuneCardBrush}"
                      CornerRadius="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Stretch="Uniform" Fill="{DynamicResource ZuneAccentBrush}" Width="18" Height="17" VerticalAlignment="Center">
                    <Path.Data>
                      <MultiBinding Converter="{x:Static design:EqualizerGeometryConverter.Instance}">
                        <Binding Path="NowPlayingIconFrame" />
                        <Binding Path="NowPlayingIconPlaying" />
                      </MultiBinding>
                    </Path.Data>
                  </Path>
                  <TextBlock Text="NOW PLAYING"
                             Classes="caption"
                             FontWeight="SemiBold"
                             LetterSpacing="1"
                             Foreground="{DynamicResource ZuneTextActiveBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Button>

            <Button Command="{Binding SelectPivotCommand}" CommandParameter="{x:Static vm:NavigationPivot.Settings}" VerticalAlignment="Center">
              <TextBlock Text="SETTINGS" Classes="mini-pivot" Classes.active="{Binding IsSettingsActive}" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- 2. Main Dynamic Content View Area with Persistent Bottom-Left Quick Dock -->
      <Grid Grid.Row="1" Margin="0,4,0,0">
        <!-- Tier A2: parallax 3D slide between pivots (Zune 4.8 "left and rear" feel) -->
        <TransitioningContentControl Content="{Binding CurrentView}">
          <TransitioningContentControl.PageTransition>
            <animations:PivotParallaxTransition />
          </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <!-- Authentic Zune Bottom-Left Quick Dock -->
        <Border HorizontalAlignment="Left" 
                VerticalAlignment="Bottom" 
                Margin="20,0,0,14" 
                Background="#EE141414" 
                BorderBrush="#2C2C2C" 
                BorderThickness="1" 
                Padding="8,4" 
                CornerRadius="0"
                IsVisible="{Binding IsQuickDockVisible}">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <!-- Device Dock Target -->
            <Button Command="{Binding OpenDeviceCommand}" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Padding="4,2" 
                    CornerRadius="0"
                    ToolTip.Tip="{Binding QuickDockDeviceTooltip}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Path Data="{x:Static design:ZuneGlyphs.Device}" Stretch="Uniform" Stroke="{DynamicResource ZuneTextSecondaryBrush}" StrokeThickness="1.4" Width="18" Height="18" 
                       Opacity="{Binding QuickDockDeviceOpacity}" 
                       VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding QuickDockDeviceName}" 
                             FontSize="10" 
                             FontWeight="SemiBold" 
                             Foreground="{DynamicResource ZuneTextActiveBrush}" 
                             LetterSpacing="0.5" />
                  <TextBlock Text="{Binding QuickDockDeviceStatus}" 
                             FontSize="8" 
                             Foreground="{DynamicResource ZuneTextDimmedBrush}" />
                </StackPanel>
              </StackPanel>
            </Button>

            <!-- Hairline Separator -->
            <Rectangle Width="1" Height="18" Fill="{DynamicResource ZuneSubtleBorderBrush}" VerticalAlignment="Center" />

            <!-- Playlists Quick Target -->
            <Button Command="{Binding OpenPlaylistsCommand}" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Padding="4,2" 
                    CornerRadius="0"
                    ToolTip.Tip="Open Playlists manager">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="📋" FontSize="11" Foreground="{DynamicResource ZuneAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="PLAYLISTS" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource ZuneTextSecondaryBrush}" 
                           LetterSpacing="0.5" 
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 3. Docked Zune Minimalist Player HUD Bar -->
      <Border Grid.Row="2" 
              Background="{DynamicResource ZuneSurfaceElevatedBrush}" 
              Height="74" 
              CornerRadius="0"
              BorderBrush="{DynamicResource ZuneBorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,*">
          <!-- 2px Hairline Seek Scrubber across Full Window Width -->
          <ProgressBar Grid.Row="0" 
                       Height="3" 
                       CornerRadius="0"
                       Value="{Binding ProgressPercentage}" 
                       Maximum="1.0" 
                       Foreground="{DynamicResource ZuneAccentBrush}" 
                       Background="{DynamicResource ZuneInputBackgroundBrush}" />

          <!-- Controls Row (Auto columns keep the HUD intact down to the authentic 734px minimum) -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="28,0,28,0" VerticalAlignment="Center">
            <!-- Left: Track Metadata & Heart / Broken Heart Rating -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <!-- Sharp Square Artwork Box -->
              <Border Width="46" Height="46" Background="{DynamicResource ZuneCardBrush}" CornerRadius="0" BorderBrush="{DynamicResource ZuneBorderBrush}" BorderThickness="1">
                <TextBlock Text="♫" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
              </Border>

              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='Not Playing'}"
                           Classes="body"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="150" />
                <TextBlock Text="{Binding CurrentTrack.ArtistName, FallbackValue='Zune Player'}"
                           Classes="caption"
                           Foreground="{DynamicResource ZuneTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="150" />
              </StackPanel>

              <!-- Zune Signature Tri-State Rating (Heart & Broken Heart) -->
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0">
                <!-- Favorite Heart Button -->
                <Button Command="{Binding ToggleFavoriteCommand}" Padding="4" ToolTip.Tip="Love this song">
                  <Panel Width="17" Height="15">
                    <Path Data="{x:Static design:ZuneGlyphs.Heart}" Stretch="Uniform" Fill="{DynamicResource ZuneAccentBrush}" IsVisible="{Binding IsFavorite}" />
                    <Path Data="{x:Static design:ZuneGlyphs.Heart}" Stretch="Uniform" Fill="{DynamicResource ZuneTextDimmedBrush}" IsVisible="{Binding !IsFavorite}" />
                  </Panel>
                </Button>

                <!-- Dislike Broken Heart Button -->
                <Button Command="{Binding ToggleDislikeCommand}" Padding="4" ToolTip.Tip="Dislike and skip song">
                  <Panel Width="17" Height="15">
                    <Path Data="{x:Static design:ZuneGlyphs.BrokenHeart}" Stretch="Uniform" Fill="{DynamicResource ZuneAccentBrush}" IsVisible="{Binding IsDisliked}" />
                    <Path Data="{x:Static design:ZuneGlyphs.BrokenHeart}" Stretch="Uniform" Fill="{DynamicResource ZuneTextDimmedBrush}" IsVisible="{Binding !IsDisliked}" />
                  </Panel>
                </Button>
              </StackPanel>
            </StackPanel>

            <!-- Center: Complete Transport Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
              <!-- Shuffle -->
              <Button Command="{Binding ToggleShuffleCommand}" Padding="6" ToolTip.Tip="Shuffle">
                <Panel Width="23" Height="23">
                  <Path Data="{x:Static design:ZuneGlyphs.Shuffle}" Stretch="Uniform" Stroke="{DynamicResource ZuneAccentBrush}" StrokeThickness="2" IsVisible="{Binding Shuffle}" Width="23" Height="23" />
                  <Path Data="{x:Static design:ZuneGlyphs.Shuffle}" Stretch="Uniform" Stroke="{DynamicResource ZuneTextSecondaryBrush}" StrokeThickness="2" IsVisible="{Binding !Shuffle}" Width="23" Height="23" />
                </Panel>
              </Button>

              <!-- Previous -->
              <Button Command="{Binding PreviousCommand}" Padding="6" ToolTip.Tip="Previous">
                <Path Data="{x:Static design:ZuneGlyphs.SkipBack}" Stretch="Uniform" Fill="{DynamicResource ZuneTextActiveBrush}" Width="25" Height="25" />
              </Button>

              <!-- Play / Pause Circle Accent Button -->
              <Button Command="{Binding PlayPauseCommand}" Padding="4" ToolTip.Tip="Play / Pause">
                <Panel Width="35" Height="35">
                  <Path Data="{x:Static design:ZuneGlyphs.Play}" Stretch="Uniform" Fill="{DynamicResource ZuneTextActiveBrush}" IsVisible="{Binding !IsPlaying}" Width="35" Height="35" />
                  <Path Data="{x:Static design:ZuneGlyphs.Pause}" Stretch="Uniform" Fill="{DynamicResource ZuneTextActiveBrush}" IsVisible="{Binding IsPlaying}" Width="35" Height="35" />
                </Panel>
              </Button>

              <!-- Next -->
              <Button Command="{Binding NextCommand}" Padding="6" ToolTip.Tip="Next">
                <Path Data="{x:Static design:ZuneGlyphs.SkipForward}" Stretch="Uniform" Fill="{DynamicResource ZuneTextActiveBrush}" Width="25" Height="25" />
              </Button>

              <!-- Repeat -->
              <Button Command="{Binding ToggleRepeatCommand}" Padding="6" ToolTip.Tip="Repeat">
                <Panel Width="23" Height="23">
                  <Path Data="{x:Static design:ZuneGlyphs.Repeat}" Stretch="Uniform" Stroke="{DynamicResource ZuneAccentBrush}" StrokeThickness="2" IsVisible="{Binding Repeat}" Width="23" Height="23" />
                  <Path Data="{x:Static design:ZuneGlyphs.Repeat}" Stretch="Uniform" Stroke="{DynamicResource ZuneTextSecondaryBrush}" StrokeThickness="2" IsVisible="{Binding !Repeat}" Width="23" Height="23" />
                </Panel>
              </Button>
            </StackPanel>

            <!-- Right: Scrub Timers & Volume Slider -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock Text="{Binding ElapsedTimeText}" Classes="caption" VerticalAlignment="Center" />
              <TextBlock Text="/" Classes="caption" VerticalAlignment="Center" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
              <TextBlock Text="{Binding RemainingTimeText}" Classes="caption" VerticalAlignment="Center" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />

              <!-- Volume Control -->
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
                <Path Data="{x:Static design:ZuneGlyphs.Speaker}" Stretch="Uniform" Fill="{DynamicResource ZuneTextActiveBrush}" Width="19" Height="16" VerticalAlignment="Center" />
                <Slider Width="70"
                        Value="{Binding Volume}" 
                        Minimum="0" 
                        Maximum="100" 
                        VerticalAlignment="Center" />
              </StackPanel>

              <!-- Fullscreen Now Playing trigger -->
              <Button Command="{Binding ToggleNowPlayingCommand}" Padding="4" ToolTip.Tip="Full screen Now Playing">
                <TextBlock Text="⤢" FontSize="16" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- Sync Instruction Toast (SYNCANIMATION / SYNCINSTRUCTIONTOAST parity + Tier A4 slide) -->
      <Border Grid.Row="0" Grid.RowSpan="3"
              IsHitTestVisible="{Binding DeviceVM.HasSyncToast}"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Right"
              Margin="0,0,24,88"
              Background="#F0181818"
              BorderBrush="{DynamicResource ZuneAccentBrush}"
              BorderThickness="1"
              CornerRadius="0"
              Padding="16,12"
              ZIndex="90"
              Opacity="{Binding DeviceVM.HasSyncToast, Converter={x:Static conv:SyncToastOpacityConverter.Instance}}">
        <Border.RenderTransform>
          <TranslateTransform Y="{Binding DeviceVM.HasSyncToast, Converter={x:Static conv:SyncToastSlideConverter.Instance}}" />
        </Border.RenderTransform>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Path Data="{x:Static design:ZuneGlyphs.Sync}" Stretch="Uniform" Stroke="{DynamicResource ZuneAccentBrush}" StrokeThickness="1.6" Width="24" Height="24" VerticalAlignment="Center" />
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding DeviceVM.SyncToastText}" Classes="caption" FontWeight="Bold" LetterSpacing="1" Foreground="{DynamicResource ZuneAccentBrush}" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding DeviceVM.SyncProgress}" Height="3" CornerRadius="0" Foreground="{DynamicResource ZuneAccentBrush}" Width="240" />
            <TextBlock Text="{Binding DeviceVM.SyncToastInstruction}" Classes="caption" FontSize="9" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- First-Launch Wizard Overlay (FIRSTLAUNCH parity) — full-shell takeover -->
      <Grid Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsFirstLaunchWizardOpen}" Background="#E8000000" ZIndex="110">
        <views:FirstLaunchWizardView DataContext="{Binding FirstLaunchWizardVM}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>

      <!-- What's New Overlay (WHATSNEW parity) -->
      <Grid Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsWhatsNewOpen}" Background="#D9000000" ZIndex="105">
        <views:WhatsNewView DataContext="{Binding WhatsNewVM}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>

      <!-- FirstConnect Wizard Overlay (FIRSTCONNECT parity) — per-device-arrival -->
      <Grid Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsFirstConnectWizardOpen}" Background="#D9000000" ZIndex="108">
        <views:FirstConnectWizardView DataContext="{Binding FirstConnectWizardVM}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>

      <!-- In-Shell Modal Dialog (Phase 19a) — confirmations/alerts (DIALOG.UIX / ERRORDIALOG.UIX parity) -->
      <Grid Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsDialogOpen}" Background="#E8000000" ZIndex="130">
        <Border Background="{DynamicResource ZuneSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource ZuneBorderBrush}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="28"
                MinWidth="400"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="18">
            <TextBlock Text="{Binding DialogTitle}" Classes="hero" FontSize="24" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DialogMessage}" Classes="body" TextWrapping="Wrap" MaxWidth="460" />
            <TextBox Text="{Binding DialogInput, Mode=TwoWay}"
                     IsVisible="{Binding IsDialogPrompt}"
                     Watermark="Type here…"
                     AcceptsReturn="False"
                     MinWidth="420"
                     MaxWidth="460"
                     CornerRadius="0" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
              <Button Classes="zune-action"
                      IsVisible="{Binding HasDialogCancel}"
                      Command="{Binding CancelDialogCommand}">
                <TextBlock Text="{Binding DialogCancelText}" FontWeight="SemiBold" FontSize="11" />
              </Button>
              <Button Classes="zune-accent-btn"
                      Command="{Binding ConfirmDialogCommand}">
                <TextBlock Text="{Binding DialogConfirmText}" FontWeight="SemiBold" FontSize="11" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Panel>
</UserControl>
