<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dorado.UI.ViewModels;assembly=Dorado.UI"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             x:Class="Dorado.UI.Views.MetadataEditView"
             x:DataType="vm:MetadataEditViewModel">

  <Border Background="#161616" 
          BorderBrush="{DynamicResource ZuneBorderBrush}" 
          BorderThickness="1" 
          CornerRadius="0"
          Padding="32"
          MaxWidth="540"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="20">
      <!-- Dialog Header -->
      <StackPanel Spacing="4">
        <TextBlock Text="edit info" Classes="hero" FontSize="32" />
        <TextBlock Text="{Binding FilePath}" Classes="caption" Foreground="{DynamicResource ZuneTextDimmedBrush}" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- Fields Grid -->
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,8,0,0">
        <!-- Title (Span 2) -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,14">
          <TextBlock Text="TITLE" Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          <TextBox Text="{Binding Title}" CornerRadius="0" Background="{DynamicResource ZuneSurfaceElevatedBrush}" Foreground="{DynamicResource ZuneTextActiveBrush}" BorderThickness="0" Padding="8,6" />
        </StackPanel>

        <!-- Artist (Span 2) -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,14">
          <TextBlock Text="ARTIST" Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          <TextBox Text="{Binding ArtistName}" CornerRadius="0" Background="{DynamicResource ZuneSurfaceElevatedBrush}" Foreground="{DynamicResource ZuneTextActiveBrush}" BorderThickness="0" Padding="8,6" />
        </StackPanel>

        <!-- Album (Span 2) -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,14">
          <TextBlock Text="ALBUM" Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          <TextBox Text="{Binding AlbumTitle}" CornerRadius="0" Background="{DynamicResource ZuneSurfaceElevatedBrush}" Foreground="{DynamicResource ZuneTextActiveBrush}" BorderThickness="0" Padding="8,6" />
        </StackPanel>

        <!-- Left Column: Genre & Year -->
        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="14" Margin="0,0,12,0">
          <StackPanel Spacing="4">
            <TextBlock Text="GENRE" Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
            <TextBox Text="{Binding Genre}" CornerRadius="0" Background="{DynamicResource ZuneSurfaceElevatedBrush}" Foreground="{DynamicResource ZuneTextActiveBrush}" BorderThickness="0" Padding="8,6" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="YEAR" Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
            <TextBox Text="{Binding Year}" CornerRadius="0" Background="{DynamicResource ZuneSurfaceElevatedBrush}" Foreground="{DynamicResource ZuneTextActiveBrush}" BorderThickness="0" Padding="8,6" />
          </StackPanel>
        </StackPanel>

        <!-- Right Column: Track # & Disc # -->
        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="14" Margin="12,0,0,0">
          <StackPanel Spacing="4">
            <TextBlock Text="TRACK #" Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
            <TextBox Text="{Binding TrackNumber}" CornerRadius="0" Background="{DynamicResource ZuneSurfaceElevatedBrush}" Foreground="{DynamicResource ZuneTextActiveBrush}" BorderThickness="0" Padding="8,6" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="DISC #" Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
            <TextBox Text="{Binding DiscNumber}" CornerRadius="0" Background="{DynamicResource ZuneSurfaceElevatedBrush}" Foreground="{DynamicResource ZuneTextActiveBrush}" BorderThickness="0" Padding="8,6" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Status Message -->
      <TextBlock Text="{Binding StatusMessage}" Classes="caption" Foreground="#FF5555" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Buttons Strip -->
      <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Classes="zune-action" Command="{Binding SaveCommand}">
          <TextBlock Text="SAVE CHANGES" Classes="caption" FontWeight="SemiBold" />
        </Button>
        <Button Classes="zune-action" Command="{Binding CancelCommand}">
          <TextBlock Text="CANCEL" Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
