<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dorado.UI.ViewModels;assembly=Dorado.UI"
             xmlns:design="clr-namespace:Dorado.UI.Design;assembly=Dorado.UI"
             xmlns:models="clr-namespace:Dorado.Domain.Models;assembly=Dorado.Domain"
             xmlns:views="clr-namespace:Dorado.UI.Views;assembly=Dorado.UI"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="Dorado.UI.Views.VideoLibraryView"
             TextInput="OnTypeAheadText"
             x:DataType="vm:VideoLibraryViewModel">

  <Panel>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,16,0,0">

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="videos" Classes="hero" />
      <TextBlock Text="{Binding StatusText}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <!-- Scan strip -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,12">
      <TextBox Grid.Column="0" Name="ScanPathBox" Watermark="folder to scan for videos (e.g. ~/Videos)" CornerRadius="0" />
      <Button Grid.Column="1" Classes="zune-action" Margin="8,0,0,0" Command="{Binding ScanFolderCommand}" CommandParameter="{Binding #ScanPathBox.Text}">
        <TextBlock Text="SCAN FOR VIDEOS" Classes="caption" FontWeight="SemiBold" />
      </Button>
    </Grid>

    <!-- Video Grid -->
    <ScrollViewer Grid.Row="2">
      <Panel>
        <ItemsControl x:Name="VideosList" ItemsSource="{Binding Videos}" IsVisible="{Binding HasVideos}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="models:Video">
              <Button Command="{Binding $parent[UserControl].((vm:VideoLibraryViewModel)DataContext).PlayVideoCommand}"
                      CommandParameter="{Binding}"
                      Padding="0" Margin="0,0,20,20">
                <Border Background="{DynamicResource ZuneSurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource ZuneBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Width="210"
                        Height="170"
                        Padding="10">
                  <Grid RowDefinitions="*,Auto,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource ZuneCardBrush}" CornerRadius="0">
                      <Grid>
                        <Path Data="{x:Static design:ZuneGlyphs.PlayCircle}" Stretch="Uniform" Fill="{DynamicResource ZuneAccentBrush}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85" />
                      </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" Classes="body" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,2" />
                    <TextBlock Grid.Row="2" Text="{Binding Duration, StringFormat='{}{0:hh\\:mm\\:ss}'}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty State -->
        <StackPanel IsVisible="{Binding !HasVideos}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
          <Path Data="{x:Static design:ZuneGlyphs.PhotoFrame}" Stretch="Uniform" Stroke="{DynamicResource ZuneTextSecondaryBrush}" StrokeThickness="1.6" Width="64" Height="48" HorizontalAlignment="Center" Opacity="0.6" />
          <TextBlock Text="no videos yet" Classes="hero" HorizontalAlignment="Center" />
          <TextBlock Text="Scan a folder above — MP4, MKV, MOV, AVI, WMV and WebM are supported."
                     Classes="body" Foreground="{DynamicResource ZuneTextSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>
    </ScrollViewer>

    <TextBlock Grid.Row="3" Text="" />
  </Grid>

  <!-- Video Player Overlay -->
  <Grid IsVisible="{Binding IsPlayerOpen}" Background="#E8000000">
    <views:VideoPlaybackView DataContext="{Binding ActivePlayerVM}" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Grid>
  </Panel>
</UserControl>
