<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="clr-namespace:Dorado.UI.ViewModels;assembly=Dorado.UI"
              xmlns:models="clr-namespace:Dorado.Domain.Models;assembly=Dorado.Domain"
              xmlns:conv="clr-namespace:Dorado.UI.Converters;assembly=Dorado.UI"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Dorado.UI.Views.DeviceView"
             x:DataType="vm:DeviceViewModel">

  <Grid Margin="40,20,40,20">
    <!-- State 1: Device Connected -->
    <StackPanel IsVisible="{Binding HasDevice}" Spacing="24" MaxWidth="720" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding DeviceName}" Classes="hero" />
        <TextBlock Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}SERIAL: {0} • FIRMWARE: {1}">
              <Binding Path="SerialNumber" />
              <Binding Path="FirmwareVersion" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </StackPanel>

      <!-- Section: Storage Gas Gauge Meter -->
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="DEVICE STORAGE" Classes="section-header" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding StorageText}" Classes="caption" Foreground="{DynamicResource ZuneAccentBrush}" VerticalAlignment="Center" />
        </Grid>

        <!-- Segmented Multi-Color Gas Gauge Bar -->
        <Border BorderBrush="{DynamicResource ZuneBorderBrush}" BorderThickness="1" CornerRadius="0" Height="20" Background="{DynamicResource ZuneBackgroundBrush}">
          <Grid x:Name="GasGaugeGrid">
            <!-- Music (Accent/Pink) -->
            <Border Grid.Column="0" Background="{DynamicResource ZuneAccentBrush}" ToolTip.Tip="{Binding MusicText}" CornerRadius="0" />
            <!-- Video (Amber/Orange) -->
            <Border Grid.Column="1" Background="{DynamicResource ZuneOrangeBrush}" ToolTip.Tip="{Binding VideoText}" CornerRadius="0" />
            <!-- Pictures (Cyan) -->
            <Border Grid.Column="2" Background="{DynamicResource ZuneCyanBrush}" ToolTip.Tip="{Binding PhotoText}" CornerRadius="0" />
            <!-- Podcasts (Lime) -->
            <Border Grid.Column="3" Background="{DynamicResource ZuneLimeBrush}" ToolTip.Tip="{Binding PodcastText}" CornerRadius="0" />
            <!-- System / Other (Grey) -->
            <Border Grid.Column="4" Background="{DynamicResource ZuneTextDimmedBrush}" ToolTip.Tip="{Binding SystemText}" CornerRadius="0" />
            <!-- Free Space (Dark Charcoal) -->
            <Border Grid.Column="5" Background="{DynamicResource ZuneSurfaceElevatedBrush}" ToolTip.Tip="{Binding FreeText}" CornerRadius="0" />
          </Grid>
        </Border>

        <!-- Color Legend Row -->
        <WrapPanel Margin="0,4,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,8">
            <Border Width="10" Height="10" Background="{DynamicResource ZuneAccentBrush}" CornerRadius="0" />
            <TextBlock Text="{Binding MusicText}" Classes="caption" FontSize="10" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,8">
            <Border Width="10" Height="10" Background="{DynamicResource ZuneOrangeBrush}" CornerRadius="0" />
            <TextBlock Text="{Binding VideoText}" Classes="caption" FontSize="10" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,8">
            <Border Width="10" Height="10" Background="{DynamicResource ZuneCyanBrush}" CornerRadius="0" />
            <TextBlock Text="{Binding PhotoText}" Classes="caption" FontSize="10" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,8">
            <Border Width="10" Height="10" Background="{DynamicResource ZuneLimeBrush}" CornerRadius="0" />
            <TextBlock Text="{Binding PodcastText}" Classes="caption" FontSize="10" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,8">
            <Border Width="10" Height="10" Background="{DynamicResource ZuneTextDimmedBrush}" CornerRadius="0" />
            <TextBlock Text="{Binding SystemText}" Classes="caption" FontSize="10" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,8">
            <Border Width="10" Height="10" Background="{DynamicResource ZuneSurfaceElevatedBrush}" BorderBrush="#444444" BorderThickness="1" CornerRadius="0" />
            <TextBlock Text="{Binding FreeText}" Classes="caption" FontSize="10" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
          </StackPanel>
        </WrapPanel>

        <!-- Space Reservation Control -->
        <StackPanel Spacing="6" Margin="0,8,0,0">
          <TextBlock Text="SPACE RESERVATION" Classes="section-header" FontSize="11" />
          <TextBlock Text="{Binding SpaceReservationSummaryText}" Classes="caption" Foreground="{DynamicResource ZuneAccentBrush}" />
          <Grid ColumnDefinitions="*,Auto" MaxWidth="500" HorizontalAlignment="Left" Margin="0,4,0,0">
            <Slider Grid.Column="0" 
                    Value="{Binding SpaceReservationPercent}" 
                    Minimum="0" 
                    Maximum="50" 
                    SmallChange="5" 
                    LargeChange="10" 
                    Width="320" 
                    HorizontalAlignment="Left" />
            <TextBlock Grid.Column="1" 
                       Text="{Binding SpaceReservationPercent, StringFormat={}{0}%}" 
                       Classes="body" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       Margin="12,0,0,0" />
          </Grid>
        </StackPanel>
      </StackPanel>

      <!-- Sync Controls & Progress -->
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="zune-action" Command="{Binding BuildSyncPlanCommand}">
            <TextBlock Text="PREVIEW WHAT WILL SYNC" Classes="section-header" />
          </Button>
          <Button Classes="zune-action" Command="{Binding SyncCommand}">
            <TextBlock Text="SYNC TO DEVICE" Classes="section-header" Foreground="{DynamicResource ZuneAccentBrush}" />
          </Button>
          <Button Classes="zune-action" Command="{Binding StartGuestSessionCommand}" IsVisible="{Binding !IsGuestSession}">
            <TextBlock Text="GUEST SESSION" Classes="section-header" />
          </Button>
          <Button Classes="zune-action" Command="{Binding EndGuestSessionCommand}" IsVisible="{Binding IsGuestSession}">
            <TextBlock Text="END GUEST SESSION" Classes="section-header" Foreground="#FF5555" />
          </Button>
        </StackPanel>
        <ProgressBar Value="{Binding SyncProgress}" Maximum="1.0" Height="4" CornerRadius="0"
                     Foreground="{DynamicResource ZuneAccentBrush}" Background="{DynamicResource ZuneSurfaceElevatedBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding HasSyncToast}">
          <Image Source="avares://Dorado.UI/Assets/Zune/Sync/SYNC.ACTIVELYSYNCING.PNG" Width="20" Height="20" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SyncToastInstruction}" Classes="caption" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
        </StackPanel>
      </StackPanel>

      <!-- Section: "What will sync" Dry-Run Manifest -->
      <StackPanel Spacing="8" IsVisible="{Binding HasSyncPlan}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="WHAT WILL SYNC" Classes="section-header" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <TextBlock Text="{Binding PlanSummaryText}" Classes="caption" Foreground="{DynamicResource ZuneAccentBrush}" />
            <TextBlock Text="{Binding PlanFreeSpaceText}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          </StackPanel>
        </Grid>

        <ScrollViewer MaxHeight="230">
          <ItemsControl ItemsSource="{Binding PlannedItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:TransferItem">
                <Border BorderBrush="{DynamicResource ZuneBorderBrush}" BorderThickness="0,0,0,1" Padding="4,6">
                  <Grid ColumnDefinitions="64,60,*,110,90">
                    <TextBlock Grid.Column="0" Text="{Binding Action}" Classes="caption" FontWeight="Bold" FontSize="9"
                               Foreground="{Binding Action, Converter={x:Static conv:TransferActionColorConverter.Instance}}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Category}" Classes="caption" FontSize="9" Foreground="{DynamicResource ZuneTextDimmedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" Classes="body" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Classes="caption" FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding SizeBytes, Converter={x:Static conv:BytesToMegabytesConverter.Instance}}" Classes="caption" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>

      <!-- Section: Device Contents (Reverse Sync) -->
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="ON DEVICE" Classes="section-header" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding GuestSessionBadgeText}" Classes="caption" FontWeight="Bold" Foreground="#FFB400" VerticalAlignment="Center" IsVisible="{Binding IsGuestSession}" />
            <Button Classes="zune-action" Command="{Binding RefreshDeviceContentsCommand}" VerticalAlignment="Center">
              <TextBlock Text="REFRESH" Classes="caption" FontSize="9" FontWeight="SemiBold" />
            </Button>
          </StackPanel>
        </Grid>

        <ScrollViewer MaxHeight="180">
          <ItemsControl ItemsSource="{Binding DeviceContents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:DeviceContentItem">
                <Border BorderBrush="{DynamicResource ZuneBorderBrush}" BorderThickness="0,0,0,1" Padding="4,6">
                  <Grid ColumnDefinitions="70,*,100,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Category}" Classes="caption" FontSize="9" Foreground="{DynamicResource ZuneTextDimmedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="body" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding SizeBytes, Converter={x:Static conv:BytesToMegabytesConverter.Instance}}" Classes="caption" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
                    <Button Grid.Column="3" Command="{Binding $parent[UserControl].((vm:DeviceViewModel)DataContext).QueueCopyBackCommand}" CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="6,2" ToolTip.Tip="Copy back to collection">
                      <TextBlock Text="COPY BACK" Classes="caption" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource ZuneAccentBrush}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="{Binding PendingImports.Count, StringFormat='{}{0} item(s) queued to copy back to the collection'}"
                   Classes="caption" Foreground="{DynamicResource ZuneAccentBrush}"
                   IsVisible="{Binding PendingImports.Count, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </StackPanel>

    <!-- State 2: No Device Connected -->
    <StackPanel IsVisible="{Binding !HasDevice}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
      <Image Source="avares://Dorado.UI/Assets/Zune/Branding/ZUNEHDDEVICES.PNG" Width="64" Height="74" HorizontalAlignment="Center" Margin="0,0,0,8" />
      <TextBlock Text="connect a zune" Classes="hero" HorizontalAlignment="Center" />
      <TextBlock Text="Attach your Zune 30, Zune 4/8/16, Zune 80/120, or Zune HD via USB cable." 
                 Classes="body" 
                 Foreground="{DynamicResource ZuneTextSecondaryBrush}"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
