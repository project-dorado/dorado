<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dorado.UI.ViewModels;assembly=Dorado.UI"
             xmlns:models="clr-namespace:Dorado.Domain.Models;assembly=Dorado.Domain"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Dorado.UI.Views.PodcastsView"
             TextInput="OnTypeAheadText"
             x:DataType="vm:PodcastsViewModel">

  <Grid RowDefinitions="Auto,*" Margin="40,6,40,16">
    <!-- Top Bar: RSS Feed Subscription Input -->
    <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" 
                 Watermark="Paste Podcast RSS Feed URL (e.g. https://feeds.npr.org/...)..." 
                 Text="{Binding NewFeedUrl}"
                 CornerRadius="0"
                 Background="{DynamicResource ZuneSurfaceElevatedBrush}"
                 Foreground="{DynamicResource ZuneTextActiveBrush}"
                 BorderBrush="{DynamicResource ZuneBorderBrush}"
                 BorderThickness="1"
                 Padding="12,8" />
        <Button Grid.Column="1" 
                Classes="zune-accent-btn" 
                Command="{Binding SubscribeCommand}"
                Margin="12,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="+" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="SUBSCRIBE PODCAST" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <TextBlock Text="{Binding SubscribeStatus}"
                 Classes="caption"
                 Foreground="{DynamicResource ZuneAccentBrush}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasSubscribeStatus}" />
    </StackPanel>

    <!-- Content: Two-Column Podcasts Browser -->
    <Grid Grid.Row="1" ColumnDefinitions="300,32,*">
      
      <!-- Left Column: Podcast Series Subscriptions -->
      <Border Grid.Column="0" 
              BorderBrush="{DynamicResource ZuneBorderBrush}" 
              BorderThickness="0,0,1,0" 
              Padding="0,0,16,0">
        <ScrollViewer>
          <ItemsControl x:Name="PodcastsList" ItemsSource="{Binding Podcasts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PodcastSeries">
                <Button Command="{Binding $parent[UserControl].((vm:PodcastsViewModel)DataContext).SelectPodcastCommand}"
                        CommandParameter="{Binding}"
                        HorizontalAlignment="Stretch"
                        Padding="0" 
                        Margin="0,0,0,12">
                  <Border Background="{DynamicResource ZuneSurfaceElevatedBrush}" 
                          BorderBrush="{DynamicResource ZuneBorderBrush}" 
                          BorderThickness="1" 
                          CornerRadius="0" 
                          Padding="14">
                    <Grid ColumnDefinitions="48,*">
                      <Border Grid.Column="0" Width="44" Height="44" Background="{DynamicResource ZuneCardBrush}" CornerRadius="0">
                        <TextBlock Text="🎙" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Title}" Classes="body" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Author}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding UnplayedCount, StringFormat='{}{0} unplayed'}" Classes="caption" Foreground="{DynamicResource ZuneAccentBrush}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Right Column: Episodes Listing -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <!-- Series Header -->
        <Border Grid.Row="0" Margin="0,0,0,20">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding SelectedPodcast.Title, FallbackValue='Select a Podcast'}" Classes="mega-title" />
            <TextBlock Text="{Binding SelectedPodcast.Author}" Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource ZuneAccentBrush}" LetterSpacing="1" />
            <TextBlock Text="{Binding SelectedPodcast.Description}" Classes="body" Foreground="{DynamicResource ZuneTextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="700" Margin="0,4,0,0" />
            <!-- PODCASTSERIESPANEL parity: mark all as played / unplayed -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
              <Button Command="{Binding MarkAllPlayedCommand}" ToolTip.Tip="Mark every episode in this series as played">
                <TextBlock Text="MARK ALL PLAYED" Classes="mini-pivot" />
              </Button>
              <Button Command="{Binding MarkAllUnplayedCommand}" ToolTip.Tip="Mark every episode in this series as unplayed">
                <TextBlock Text="MARK ALL UNPLAYED" Classes="mini-pivot" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Episode Items -->
        <ScrollViewer Grid.Row="1">
          <ItemsControl x:Name="EpisodesList" ItemsSource="{Binding Episodes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PodcastEpisode">
                <Button Command="{Binding $parent[UserControl].((vm:PodcastsViewModel)DataContext).PlayEpisodeCommand}"
                        CommandParameter="{Binding}"
                        HorizontalAlignment="Stretch"
                        Padding="0" 
                        Margin="0,0,0,8">
                  <Border Background="{DynamicResource ZuneSurfaceElevatedBrush}" 
                          BorderBrush="{DynamicResource ZuneBorderBrush}" 
                          BorderThickness="1" 
                          CornerRadius="0" 
                          Padding="16,12">
                    <Grid ColumnDefinitions="*,100,Auto">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding Title}" Classes="body" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                        <TextBlock Text="{Binding PublishedAtUtc, StringFormat='{}{0:MMM dd, yyyy}'}" Classes="caption" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
                      </StackPanel>

                      <TextBlock Grid.Column="1" Text="{Binding Duration, StringFormat={}{0:m\\:ss}}" Classes="caption" VerticalAlignment="Center" HorizontalAlignment="Right" />

                      <Button Grid.Column="2" 
                              Classes="zune-action" 
                              Command="{Binding $parent[UserControl].((vm:PodcastsViewModel)DataContext).PlayEpisodeCommand}"
                              CommandParameter="{Binding}"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="▶" Foreground="{DynamicResource ZuneAccentBrush}" FontSize="11" />
                          <TextBlock Text="PLAY" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
