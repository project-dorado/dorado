<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dorado.UI.ViewModels;assembly=Dorado.UI"
             xmlns:design="clr-namespace:Dorado.UI.Design;assembly=Dorado.UI"
             xmlns:models="clr-namespace:Dorado.Domain.Models;assembly=Dorado.Domain"
             xmlns:views="clr-namespace:Dorado.UI.Views;assembly=Dorado.UI"
             xmlns:conv="clr-namespace:Dorado.UI.Converters;assembly=Dorado.UI"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Dorado.UI.Views.NowPlayingView"
             x:DataType="vm:NowPlayingViewModel">

  <Grid Margin="0" PointerMoved="OnPointerMoved">
    
    <!-- ============================================== -->
    <!-- MODE 1: DYNAMIC ARTIST CANVAS                  -->
    <!-- ============================================== -->
    <Grid Opacity="{Binding ArtistCanvasOpacity}"
          IsHitTestVisible="{Binding IsArtistCanvasMode}">
      <Grid.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
        </Transitions>
      </Grid.Transitions>
      <!-- Ken-Burns Pan/Zoom Animated Backdrop Photo -->
      <Grid ClipToBounds="True">
        <Image Source="{Binding CurrentBackdropImage}" 
               Stretch="UniformToFill" 
               Opacity="0.25">
          <Image.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="{Binding KenBurnsScale}" ScaleY="{Binding KenBurnsScale}" />
              <TranslateTransform X="{Binding KenBurnsTranslateX}" Y="{Binding KenBurnsTranslateY}" />
            </TransformGroup>
          </Image.RenderTransform>
        </Image>

        <!-- Dark Matte Gradient Overlay -->
        <Border CornerRadius="0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Offset="0.0" Color="#E6141414" />
              <GradientStop Offset="0.5" Color="#F20D0D0D" />
              <GradientStop Offset="1.0" Color="#FA070707" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
      </Grid>

      <!-- Procedural iris art reveal (clean-room replacement for NOWPLAYINGARTLOGO/ARTSHAPE) -->
      <views:IrisArtControl IsHitTestVisible="False" Opacity="0.6" />

      <!-- Giant Ambient Typographic Watermark (Tier A3: slow 3D Y-axis rotation while idle) -->
      <TextBlock Text="{Binding ArtistName}"
                 FontSize="140"
                 FontWeight="Bold"
                 Foreground="{DynamicResource ZuneTextWatermarkBrush}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-20,-20"
                 Opacity="{Binding IsNowPlayingIdle, Converter={x:Static conv:IdleOpacityConverter.Instance}}">
        <TextBlock.RenderTransform>
          <Rotate3DTransform AngleX="0"
                              AngleY="{Binding NowPlayingArtRotation}"
                              AngleZ="0"
                              CenterX="700"
                              CenterY="0" />
        </TextBlock.RenderTransform>
      </TextBlock>

      <!-- Iconic Zune Big Typography Overlay (Tier A3: drifts left off-screen while idle) -->
      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="64,0,0,120" Spacing="8" MaxWidth="700"
                  Opacity="{Binding IsNowPlayingIdle, Converter={x:Static conv:IdleOpacityConverter.Instance}}">
        <StackPanel.RenderTransform>
          <TranslateTransform X="{Binding NowPlayingIdleProgress, Converter={x:Static conv:IdleDriftConverter.Instance}}" />
        </StackPanel.RenderTransform>
        <TextBlock Text="{Binding TrackTitle}" 
                   FontSize="60" 
                   FontWeight="Light" 
                   FontFamily="Segoe UI, Inter, Selawik, sans-serif"
                   Foreground="{DynamicResource ZuneTextActiveBrush}" 
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding ArtistName}" 
                   FontSize="32" 
                   FontWeight="Light" 
                   FontFamily="Segoe UI, Inter, Selawik, sans-serif"
                   Foreground="{DynamicResource ZuneAccentBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
          <TextBlock Text="{Binding AlbumTitle}" Classes="body" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          <TextBlock Text="•" Classes="body" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
          <TextBlock Text="{Binding Year, StringFormat={}{0}}" Classes="body" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
          <TextBlock Text="•" Classes="body" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
          <TextBlock Text="{Binding Genre}" Classes="body" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
        </StackPanel>
      </StackPanel>

      <!-- Ambient Audio Spectrum Equalizer (Devkanro 24-Band Reactive Bars with 300ms Peak-Hold) -->
      <ItemsControl ItemsSource="{Binding VisualizerBands}" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Margin="0,0,48,32" 
                    Opacity="0.85"
                    IsHitTestVisible="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:VisualizerBandItem">
            <Panel Width="3" Height="52" VerticalAlignment="Bottom">
              <Border Width="3" 
                      Height="{Binding Value}" 
                      Background="{DynamicResource ZuneAccentBrush}" 
                      CornerRadius="0" 
                      VerticalAlignment="Bottom" />
              <!-- Devkanro 300ms Peak-Hold Cap (1px hairline) -->
              <Border Width="3" 
                      Height="1" 
                      Margin="{Binding PeakMargin}" 
                      Background="{DynamicResource ZuneTextActiveBrush}" 
                      CornerRadius="0" 
                      VerticalAlignment="Bottom" />
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Slide-out Drawer: Lyrics & Artist Biography -->
      <Border HorizontalAlignment="Right"
              Width="340"
              Background="{DynamicResource ZuneSurfaceElevatedBrush}"
              BorderBrush="{DynamicResource ZuneBorderBrush}"
              BorderThickness="1,0,0,0"
              CornerRadius="0"
              IsHitTestVisible="{Binding IsBioDrawerOpen}"
              Padding="24"
              Opacity="{Binding BioDrawerOpacity}">
            <Border.RenderTransform>
              <TranslateTransform X="{Binding BioDrawerOffsetX}" />
            </Border.RenderTransform>
        <ScrollViewer>
          <StackPanel Spacing="24">
            <!-- Biography Section -->
            <StackPanel Spacing="8">
              <TextBlock Text="BIOGRAPHY" Classes="caption" FontWeight="Bold" Foreground="{DynamicResource ZuneAccentBrush}" LetterSpacing="2" />
              <TextBlock Text="{Binding BiographyText}" Classes="body" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource ZuneTextHoverBrush}" />
              <TextBlock Text="{Binding BiographySource, StringFormat=Source: {0}}" Classes="caption" Foreground="{DynamicResource ZuneTextDimmedBrush}" IsVisible="{Binding BiographySource, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <!-- Lyrics Section -->
            <StackPanel Spacing="8">
              <TextBlock Text="LYRICS" Classes="caption" FontWeight="Bold" Foreground="{DynamicResource ZuneAccentBrush}" LetterSpacing="2" />
              <TextBlock Text="{Binding LyricsText}" Classes="body" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource ZuneTextHoverBrush}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Slide-out Drawer: Showlist (Upcoming Queue) -->
      <Border HorizontalAlignment="Right"
              Width="360"
              Background="{DynamicResource ZuneSurfaceElevatedBrush}"
              BorderBrush="{DynamicResource ZuneBorderBrush}"
              BorderThickness="1,0,0,0"
              CornerRadius="0"
              IsHitTestVisible="{Binding IsShowlistOpen}"
              Padding="24"
              Opacity="{Binding ShowlistDrawerOpacity}">
        <Border.RenderTransform>
          <TranslateTransform X="{Binding ShowlistDrawerOffsetX}" />
        </Border.RenderTransform>
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0">
              <TextBlock Text="NOW PLAYING SHOWLIST" Classes="caption" FontWeight="Bold" Foreground="{DynamicResource ZuneAccentBrush}" LetterSpacing="2" />
              <TextBlock Text="{Binding UpcomingQueueCount, StringFormat={}{0} tracks queued}" Classes="caption" Foreground="{DynamicResource ZuneTextDimmedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding ToggleShowlistCommand}" Padding="6" Classes="window-control">
              <Path Data="{x:Static design:ZuneGlyphs.Cross}" Stretch="Uniform" Stroke="{DynamicResource ZuneTextDimmedBrush}" StrokeThickness="1.5" Width="10" Height="10" VerticalAlignment="Center" />
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding UpcomingQueue}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                  <Button Command="{Binding $parent[UserControl].((vm:NowPlayingViewModel)DataContext).PlayQueueTrackCommand}"
                          CommandParameter="{Binding}"
                          HorizontalAlignment="Stretch"
                          Padding="0">
                    <Border Background="Transparent" 
                            BorderBrush="{DynamicResource ZuneBorderBrush}" 
                            BorderThickness="0,0,0,1" 
                            CornerRadius="0" 
                            Padding="10,8">
                      <Grid ColumnDefinitions="*,50">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock Text="{Binding Title}" Classes="body" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding ArtistName}" Classes="caption" Foreground="{DynamicResource ZuneTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Duration, StringFormat={}{0:m\\:ss}}" Classes="caption" Foreground="{DynamicResource ZuneTextDimmedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Floating Auto-Hiding Transport HUD -->
      <Border VerticalAlignment="Bottom" 
              HorizontalAlignment="Center" 
              Margin="0,0,0,32"
              Background="{DynamicResource ZuneCardBrush}" 
              BorderBrush="{DynamicResource ZuneBorderBrush}"
              BorderThickness="1"
              CornerRadius="0"
              Padding="24,12"
              IsVisible="{Binding IsHudVisible}">
        <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
          <!-- Favorite -->
          <Button Command="{Binding ToggleFavoriteCommand}" Padding="4" ToolTip.Tip="Love this song">
            <Panel Width="17" Height="15">
              <Path Data="{x:Static design:ZuneGlyphs.Heart}" Stretch="Uniform" Fill="{DynamicResource ZuneAccentBrush}" IsVisible="{Binding IsFavorite}" />
              <Path Data="{x:Static design:ZuneGlyphs.Heart}" Stretch="Uniform" Fill="{DynamicResource ZuneTextDimmedBrush}" IsVisible="{Binding !IsFavorite}" />
            </Panel>
          </Button>

          <!-- Previous -->
          <Button Command="{Binding PreviousCommand}" Padding="4" ToolTip.Tip="Previous">
            <Path Data="{x:Static design:ZuneGlyphs.SkipBack}" Stretch="Uniform" Fill="{DynamicResource ZuneTextActiveBrush}" Width="25" Height="25" />
          </Button>

          <!-- Play / Pause -->
          <Button Command="{Binding PlayPauseCommand}" Padding="4" ToolTip.Tip="Play / Pause">
            <Panel Width="35" Height="35">
              <Path Data="{x:Static design:ZuneGlyphs.Play}" Stretch="Uniform" Fill="{DynamicResource ZuneTextActiveBrush}" IsVisible="{Binding !IsPlaying}" Width="35" Height="35" />
              <Path Data="{x:Static design:ZuneGlyphs.Pause}" Stretch="Uniform" Fill="{DynamicResource ZuneTextActiveBrush}" IsVisible="{Binding IsPlaying}" Width="35" Height="35" />
            </Panel>
          </Button>

          <!-- Next -->
          <Button Command="{Binding NextCommand}" Padding="4" ToolTip.Tip="Next">
            <Path Data="{x:Static design:ZuneGlyphs.SkipForward}" Stretch="Uniform" Fill="{DynamicResource ZuneTextActiveBrush}" Width="25" Height="25" />
          </Button>

          <!-- Dislike -->
          <Button Command="{Binding ToggleDislikeCommand}" Padding="4" ToolTip.Tip="Dislike and skip song">
            <Panel Width="17" Height="15">
              <Path Data="{x:Static design:ZuneGlyphs.BrokenHeart}" Stretch="Uniform" Fill="{DynamicResource ZuneAccentBrush}" IsVisible="{Binding IsDisliked}" />
              <Path Data="{x:Static design:ZuneGlyphs.BrokenHeart}" Stretch="Uniform" Fill="{DynamicResource ZuneTextDimmedBrush}" IsVisible="{Binding !IsDisliked}" />
            </Panel>
          </Button>

          <!-- Showlist Toggle Button -->
          <Button Command="{Binding ToggleShowlistCommand}" Padding="4" ToolTip.Tip="Showlist (Upcoming Queue)">
            <Panel Width="20" Height="20">
              <Path Data="{x:Static design:ZuneGlyphs.ShowList}" Stretch="Uniform" Stroke="{DynamicResource ZuneAccentBrush}" StrokeThickness="2" IsVisible="{Binding IsShowlistOpen}" Width="20" Height="20" />
              <Path Data="{x:Static design:ZuneGlyphs.ShowList}" Stretch="Uniform" Stroke="{DynamicResource ZuneTextSecondaryBrush}" StrokeThickness="2" IsVisible="{Binding !IsShowlistOpen}" Width="20" Height="20" />
            </Panel>
          </Button>

          <!-- Timer (Click toggles between remaining and total time) -->
          <Button Command="{Binding ToggleTimeDisplayCommand}"
                  Padding="4,2"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  ToolTip.Tip="Toggle remaining / total duration"
                  Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding ElapsedTimeText}" Classes="caption" VerticalAlignment="Center" />
              <TextBlock Text="/" Classes="caption" VerticalAlignment="Center" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
              <TextBlock Text="{Binding FormattedDurationText}" Classes="caption" VerticalAlignment="Center" Foreground="{DynamicResource ZuneTextSecondaryBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============================================== -->
    <!-- MODE 2: ALBUM ART MOSAIC WALL                  -->
    <!-- ============================================== -->
    <Grid Opacity="{Binding MosaicWallOpacity}"
          IsHitTestVisible="{Binding IsMosaicWallMode}"
          Background="#0C0C0C">
      <Grid.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
        </Transitions>
      </Grid.Transitions>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding MosaicWallAlbums}" Margin="32">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Album">
              <Border Background="{DynamicResource ZuneSurfaceElevatedBrush}" 
                      BorderBrush="{DynamicResource ZuneBorderBrush}" 
                      BorderThickness="1"
                      CornerRadius="0" 
                      Width="150" 
                      Height="150" 
                      Margin="8">
                <Grid>
                  <Border Background="{DynamicResource ZuneCardBrush}" CornerRadius="0">
                    <Grid>
                      <!-- Typographic fallback, visible whenever the album has no decodable artwork. -->
                      <Path Data="{x:Static design:ZuneGlyphs.MusicNote}" 
                            Stretch="Uniform" 
                            Width="32" Height="32" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Fill="{DynamicResource ZuneTextDimmedBrush}" />
                      <!-- Real album art; ArtworkSourceConverter returns null for missing sources. -->
                      <Image Source="{Binding ArtworkUri, Converter={x:Static conv:ArtworkSourceConverter.Instance}}"
                             Stretch="UniformToFill" />
                    </Grid>
                  </Border>
                  <!-- Overlay Album Title at Bottom -->
                  <Border VerticalAlignment="Bottom" Background="#DD111111" Padding="6,4">
                    <TextBlock Text="{Binding Title}" Classes="caption" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ZuneTextActiveBrush}" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Top Right Action Controls (Wall/Canvas & Lyrics/Bio) -->
    <StackPanel Orientation="Horizontal" 
                Spacing="12" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="0,20,40,0">
      <!-- Mixview Constellation Discovery -->
      <Button Command="{Binding LaunchMixviewCommand}" Classes="zune-action">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Data="{x:Static design:ZuneGlyphs.Mix}" Stretch="Uniform" Fill="{DynamicResource ZuneAccentBrush}" Width="13" Height="13" VerticalAlignment="Center" />
          <TextBlock Text="MIXVIEW" Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Showlist Queue Toggle -->
      <Button Command="{Binding ToggleShowlistCommand}" Classes="zune-action">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Data="{x:Static design:ZuneGlyphs.ShowList}" Stretch="Uniform" Stroke="{DynamicResource ZuneAccentBrush}" StrokeThickness="2" Width="13" Height="13" VerticalAlignment="Center" />
          <TextBlock Text="SHOWLIST" Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Lyrics & Bio Toggle -->
      <Button Command="{Binding ToggleBioDrawerCommand}" Classes="zune-action">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Data="{x:Static design:ZuneGlyphs.QueueLines}" Stretch="Uniform" Stroke="{DynamicResource ZuneAccentBrush}" StrokeThickness="1.5" Width="12" Height="12" VerticalAlignment="Center" />
          <TextBlock Text="LYRICS &amp; BIO" Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- View Mode Switch -->
      <Button Command="{Binding ToggleModeCommand}" Classes="zune-action">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Data="{x:Static design:ZuneGlyphs.GridMosaic}" Stretch="Uniform" Fill="{DynamicResource ZuneAccentBrush}" Width="12" Height="12" VerticalAlignment="Center" />
          <TextBlock Text="WALL / CANVAS / VIDEO" Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- MODE 3: NOW PLAYING VIDEO CLIPS (NOWPLAYINGCLIPS parity) -->
    <Panel IsVisible="{Binding IsVideoMode}" Background="#FF070707">
      <Grid RowDefinitions="Auto,*" Margin="40,20,40,80">
        <StackPanel Grid.Row="0" Spacing="10">
          <TextBlock Text="now playing clips" Classes="hero" FontSize="30" />
          <Grid ColumnDefinitions="260,*" Margin="0,0,12,0">
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding LibraryVideos}"
                     SelectedItem="{Binding SelectedVideo}"
                     Background="Transparent"
                     CornerRadius="0"
                     MaxHeight="300">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Video">
                  <Border Padding="6,8" CornerRadius="0">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Title}" Classes="body" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Duration, StringFormat='{}{0:hh\\:mm\\:ss}'}" Classes="caption" FontSize="9" Foreground="{DynamicResource ZuneTextDimmedBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Panel Grid.Column="1">
              <views:VideoPlaybackView DataContext="{Binding VideoPlaybackVM}" IsVisible="{Binding HasVideoPlayback}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              <TextBlock Text="Select a video from your library to play it right here."
                         Classes="body" Foreground="{DynamicResource ZuneTextDimmedBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding !HasVideoPlayback}" />
            </Panel>
          </Grid>
        </StackPanel>
      </Grid>
    </Panel>

  </Grid>
</UserControl>
